@page "/"
@inject BudgetService Budget
@inject ExpenseService Expenses
@inject TaskService Tasks
@inject ActivityService Activities

<PageTitle>Accueil · Dashboard perso</PageTitle>

<header class="page-header">
    <h1>Bonjour 👋</h1>
    <p class="muted">@DateTime.Today.ToString("dddd d MMMM yyyy")</p>
</header>

@if (lines is null)
{
    <p class="muted">Chargement…</p>
}
else
{
    <section class="cards">
        <div class="card stat">
            <span class="stat-label">Dépensé ce mois-ci</span>
            <span class="stat-value">@spent.ToString("C")</span>
            <span class="muted">sur @planned.ToString("C") prévus (budget annuel ÷ 12)</span>
        </div>
        <div class="card stat">
            <span class="stat-label">Depuis le 1er janvier</span>
            <span class="stat-value @(ytdSpent > ytdPlanned ? "negative" : "")">@ytdSpent.ToString("C")</span>
            <span class="muted">prévu à date : @ytdPlanned.ToString("C")</span>
        </div>
        <div class="card stat">
            <span class="stat-label">Reste à dépenser</span>
            <span class="stat-value @(planned - spent < 0 ? "negative" : "")">@((planned - spent).ToString("C"))</span>
            <ProgressBar Percent="@(planned > 0 ? (double)(spent / planned * 100) : 0)" />
        </div>
        <div class="card stat">
            <span class="stat-label">Recettes ce mois-ci</span>
            <span class="stat-value positive">@income.ToString("C")</span>
            <span class="muted">
                @if (plannedIncome > 0) { @($"sur {plannedIncome.ToString("C")} prévues · solde {(income - spent >= 0 ? "+" : "")}{(income - spent).ToString("C")}") }
                else { @($"solde du mois {(income - spent >= 0 ? "+" : "")}{(income - spent).ToString("C")}") }
            </span>
        </div>
        <BalanceCard />
        <div class="card stat">
            <span class="stat-label">Tâches ouvertes</span>
            <span class="stat-value">@openTasks</span>
            @if (overdueTasks > 0)
            {
                <span class="negative">@overdueTasks en retard</span>
            }
            else
            {
                <span class="muted">aucune en retard</span>
            }
        </div>
    </section>

    <section class="home-grid">
        <div class="card">
            <div class="card-header">
                <h2>@(budgetYear ? $"Budget {DateTime.Today.Year}" : "Budget du mois")</h2>
                <span class="actions">
                    <span class="segmented small-seg">
                        <button class="@(budgetYear ? "" : "active")" @onclick="() => budgetYear = false">Mois</button>
                        <button class="@(budgetYear ? "active" : "")" @onclick="() => budgetYear = true">Année</button>
                    </span>
                    <a href="@(budgetYear ? "budget?vue=annee" : "budget")">Gérer</a>
                </span>
            </div>
            @{ var shown = budgetYear ? yearLines! : lines; }
            @if (shown.Count == 0)
            {
                <p class="muted">Aucune catégorie. <a href="budget/nouveau">Créer une catégorie</a></p>
            }
            else if (budgetYear)
            {
                <p class="muted small">Dépensé / budget annuel · prévu à date : @ytdPlanned.ToString("C")</p>
            }
            @foreach (var line in shown)
            {
                <div class="budget-line">
                    <div class="budget-line-head">
                        <span><span class="dot" style="background:@line.Category.Color"></span>@line.Category.Name</span>
                        <span class="muted">@line.Spent.ToString("C") / @line.Planned.ToString("C")</span>
                    </div>
                    <ProgressBar Percent="line.Percent" Color="@line.Category.Color" Over="line.IsOver" />
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header">
                <h2>Tâches du jour</h2>
                <span>
                    @if (dayTasks!.Count > 0) { <span class="muted">@dayTasks.Count(t => t.Status == TaskItemStatus.Done) / @dayTasks.Count · </span> }
                    <a href="taches">Planifier</a>
                </span>
            </div>
            @if (dayTasks.Count == 0)
            {
                <p class="muted">Rien de prévu aujourd'hui. <a href="taches">Choisir les tâches du jour</a></p>
            }
            <ul class="list task-list">
                @foreach (var t in dayTasks)
                {
                    <li @key="t.Id">
                        <span class="task-main">
                            <input type="checkbox" checked="@(t.Status == TaskItemStatus.Done)" title="Marquer comme terminée"
                                   @onchange="e => ToggleTask(t, (bool)e.Value!)" />
                            <a href="taches/@t.Id" class="@(t.Status == TaskItemStatus.Done ? "done" : "")">@t.Title</a>
                            @if (t.Priority == TaskPriority.High) { <span class="badge prio-high">Haute</span> }
                            @if (t.IsCarriedOver) { <span class="badge warn">Reportée</span> }
                        </span>
                        @if (t.DueDate is { } due)
                        {
                            <span class="small @(t.IsOverdue ? "negative" : "muted")">@due.ToString("d MMM")</span>
                        }
                    </li>
                }
            </ul>
            <p class="muted small">
                Demain : @(tomorrowCount == 0 ? "rien de prévu" : $"{tomorrowCount} tâche(s) prévue(s)") ·
                <a href="taches?vue=demain">Préparer demain</a>
            </p>
            @if (upcoming!.Count > 0)
            {
                <h3 class="small muted">Prochaines échéances</h3>
                <ul class="list">
                    @foreach (var t in upcoming)
                    {
                        <li>
                            <a href="taches/@t.Id">@t.Title</a>
                            <span class="@(t.IsOverdue ? "negative" : "muted")">@t.DueDate?.ToString("d MMM")</span>
                        </li>
                    }
                </ul>
            }
        </div>

        <section class="card">
            <div class="card-header">
                <h2>Au programme aujourd'hui</h2>
                <a href="planning">Planning de la semaine</a>
            </div>
            @if (activities!.Count == 0)
            {
                <p class="muted">
                    Aucune activité prévue aujourd'hui.
                    @if (slotCount > 0 && weekIsEmpty)
                    {
                        <button class="link" @onclick="ApplyWeek">Appliquer la semaine type à cette semaine</button>
                    }
                    else if (slotCount == 0)
                    {
                        <a href="planning/semaine-type">Définir ma semaine type</a>
                    }
                </p>
            }
            <ul class="list task-list day-activities">
                @foreach (var a in activities)
                {
                    var related = activityTasks.GetValueOrDefault(a.Id) ?? [];
                    <li @key="a.Id">
                        <div class="activity-line">
                            <span class="task-main">
                                <input type="checkbox" checked="@a.Done" title="Fait" @onchange="e => ToggleActivity(a, (bool)e.Value!)" />
                                <span class="muted activity-time">@a.Start.ToString("HH:mm")–@a.End.ToString("HH:mm")</span>
                                <span class="dot" style="background:@a.Category!.Color"></span>
                                <span class="@(a.Done ? "done" : "")">@(a.Title ?? a.Category.Name)</span>
                                @if (a.Title is not null) { <span class="small muted">@a.Category.Name</span> }
                            </span>
                            @if (related.Count > 0)
                            {
                                <ul class="activity-tasks">
                                    @foreach (var t in related)
                                    {
                                        <li @key="t.Id">
                                            <a href="taches/@t.Id">@t.Title</a>
                                            @if (t.PlannedFor is { } p && p <= today)
                                            {
                                                <span class="small positive">dans les tâches du jour</span>
                                            }
                                            else
                                            {
                                                <button class="link small" @onclick="() => PlanToday(t)">+ Aujourd'hui</button>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </li>
                }
            </ul>
        </section>

        <section class="card">
            <div class="card-header">
                <h2>Dernières dépenses</h2>
                <a href="depenses/nouvelle">+ Ajouter</a>
            </div>
            @if (latest!.Count == 0)
            {
                <p class="muted">Aucune dépense enregistrée.</p>
            }
            <ul class="list">
                @foreach (var e in latest)
                {
                    <li>
                        <span>
                            <span class="muted">@e.Date.ToString("dd/MM")</span>
                            <a href="depenses/@e.Id">@e.Label</a>
                            @if (e.IsTransfer)
                            {
                                <span class="badge transfer">Transfert</span>
                            }
                            else if (e.Category is not null)
                            {
                                <CategoryBadge Category="e.Category" />
                            }
                        </span>
                        <span class="amount @(e.IsIncome ? "positive" : "")">@(e.IsIncome ? "+" : "")@e.Amount.ToString("C")</span>
                    </li>
                }
            </ul>
        </section>
    </section>
}

@code {
    private List<BudgetLine>? lines;
    private List<BudgetLine>? yearLines;
    /// <summary>Suivi du budget affiché sur l'année par défaut (bascule possible sur le mois).</summary>
    private bool budgetYear = true;
    private List<TaskItem>? upcoming;
    private List<TaskItem>? dayTasks;
    private int tomorrowCount;
    private List<Expense>? latest;
    private decimal spent, planned, ytdSpent, ytdPlanned, income, plannedIncome;
    private int openTasks, overdueTasks;
    private List<PlannedActivity>? activities;
    private Dictionary<int, List<TaskItem>> activityTasks = [];
    private int slotCount;
    private bool weekIsEmpty;
    private DateOnly today = DateOnly.FromDateTime(DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.Today;
        lines = await Budget.GetMonthSummaryAsync(today.Year, today.Month);
        spent = await Expenses.GetMonthTotalAsync(today.Year, today.Month);
        planned = lines.Sum(l => l.Planned);
        var month = await Budget.GetOverviewAsync(new BudgetPeriod(today.Year, today.Month));
        income = month.ActualIncome;
        plannedIncome = month.PlannedIncome;

        var year = yearLines = await Budget.GetSummaryAsync(new BudgetPeriod(today.Year, null));
        ytdSpent = year.Sum(l => l.Spent);
        ytdPlanned = Math.Round(year.Sum(l => l.AnnualBudget) * new BudgetPeriod(today.Year, null).ElapsedFraction(DateOnly.FromDateTime(today)), 2);

        await LoadTasks();
        await LoadActivities();
        latest = await Expenses.GetLatestAsync(8);
    }

    private async Task LoadTasks()
    {
        var day = DateOnly.FromDateTime(DateTime.Today);
        var allTasks = await Tasks.GetAllAsync();
        var open = allTasks.Where(t => t.Status != TaskItemStatus.Done).ToList();
        openTasks = open.Count;
        overdueTasks = open.Count(t => t.IsOverdue);
        dayTasks = await Tasks.GetDayListAsync(day);
        tomorrowCount = (await Tasks.GetPlannedForAsync(day.AddDays(1))).Count(t => t.Status != TaskItemStatus.Done);
        // Échéances des tâches qui ne sont pas déjà dans la liste du jour.
        var inDay = dayTasks.Select(t => t.Id).ToHashSet();
        upcoming = open.Where(t => t.DueDate is not null && !inDay.Contains(t.Id)).Take(4).ToList();
    }

    private async Task ToggleTask(TaskItem task, bool done)
    {
        await Tasks.SetStatusAsync(task.Id, done ? TaskItemStatus.Done : TaskItemStatus.Todo);
        await LoadTasks();
        await LoadActivities();
    }

    private async Task LoadActivities()
    {
        today = DateOnly.FromDateTime(DateTime.Today);
        activities = await Activities.GetDayAsync(today);
        slotCount = (await Activities.GetSlotsAsync()).Count;
        weekIsEmpty = activities.Count == 0 && (await Activities.GetWeekAsync(ActivityService.MondayOf(today))).Count == 0;
        var categories = await Activities.GetCategoriesAsync();
        activityTasks = [];
        foreach (var a in activities.Where(a => !a.Done))
        {
            // Tâches de la même catégorie (ou de sa catégorie principale / ses sous-catégories) à caser dans ce créneau.
            var ids = new List<int> { a.CategoryId };
            if (a.Category!.ParentId is { } p) ids.Add(p);
            ids.AddRange(categories.Where(c => c.ParentId == a.CategoryId).Select(c => c.Id));
            var list = await Tasks.GetOpenForActivityAsync(ids);
            if (list.Count > 0) activityTasks[a.Id] = list.Take(4).ToList();
        }
    }

    private async Task ToggleActivity(PlannedActivity a, bool done)
    {
        await Activities.SetDoneAsync(a.Id, done);
        await LoadActivities();
    }

    private async Task ApplyWeek()
    {
        await Activities.ApplyTemplateAsync(ActivityService.MondayOf(today));
        await LoadActivities();
    }

    private async Task PlanToday(TaskItem t)
    {
        await Tasks.PlanAsync(t.Id, today);
        await LoadTasks();
        await LoadActivities();
    }
}
