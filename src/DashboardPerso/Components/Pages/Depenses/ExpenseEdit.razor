@page "/depenses/nouvelle"
@page "/depenses/{Id:int}"
@inject ExpenseService Expenses
@inject BudgetService Budget
@inject AccountService Accounts
@inject PayeeService Payees
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Nouvelle dépense" : "Modifier la dépense") · Dashboard perso</PageTitle>

<header class="page-header">
    <h1>@(IsNew ? "Nouvelle dépense" : "Modifier la dépense")</h1>
</header>

@if (model is null)
{
    <p class="muted">@(notFound ? "Dépense introuvable." : "Chargement…")</p>
}
else
{
    <div class="card form-card">
        <EditForm Model="model" OnValidSubmit="Save" FormName="expense-edit">
            <DataAnnotationsValidator />

            <div class="segmented">
                <button type="button" class="@(model.IsIncome ? "" : "active")" @onclick="() => model.IsIncome = false">Dépense</button>
                <button type="button" class="@(model.IsIncome ? "active" : "")" @onclick="() => model.IsIncome = true">Recette</button>
            </div>

            <div class="form-row">
                <label>
                    Date
                    <InputDate @bind-Value="model.Date" />
                </label>
                <label>
                    Montant (€)
                    <InputNumber @bind-Value="model.Amount" step="0.01" />
                    <ValidationMessage For="() => model.Amount" />
                </label>
            </div>

            <div class="form-row">
                <label>
                    Libellé
                    <InputText @bind-Value="model.Label" autofocus />
                    <ValidationMessage For="() => model.Label" />
                </label>
                <label>
                    Bénéficiaire
                    <input list="payees" value="@payeeName" @onchange="OnPayeeChanged" placeholder="ex. TOTALENERGIES" />
                    <datalist id="payees">
                        @foreach (var n in payeeNames) { <option value="@n"></option> }
                    </datalist>
                    @if (payeeHint is not null) { <span class="muted small">@payeeHint</span> }
                </label>
            </div>

            <div class="form-row">
                @if (model.IsIncome)
                {
                    <label>
                        Catégorie
                        <select disabled><option>Recette (hors budget)</option></select>
                    </label>
                }
                else if (splitting)
                {
                    <label>
                        Catégorie
                        <select disabled><option>Ventilée sur plusieurs catégories</option></select>
                    </label>
                }
                else
                {
                    <label>
                        Catégorie
                        <InputSelect @bind-Value="model.CategoryId" disabled="@model.IsTransfer">
                            <option value="">Sans catégorie</option>
                            <CategoryOptions Categories="categories" />
                        </InputSelect>
                        @if (!model.IsTransfer)
                        {
                            <button type="button" class="link small left" @onclick="StartSplit">Ventiler sur plusieurs catégories</button>
                        }
                    </label>
                }
                <label>
                    Compte / carte
                    <InputSelect @bind-Value="model.AccountId">
                        @foreach (var a in accounts) { <option value="@a.Id">@a.Label</option> }
                    </InputSelect>
                </label>
            </div>

            @if (splitting && !model.IsIncome && !model.IsTransfer)
            {
                <div class="split-editor">
                    <strong>Ventilation</strong>
                    @foreach (var part in parts)
                    {
                        <div class="split-row">
                            <select value="@part.CategoryId" @onchange="e => part.CategoryId = int.TryParse(e.Value as string, out var c) ? c : null">
                                <option value="">Sans catégorie</option>
                                <CategoryOptions Categories="categories" />
                            </select>
                            <input type="number" step="0.01" @bind="part.Amount" @bind:event="oninput" />
                            <button type="button" class="link small" title="Retirer" @onclick="() => parts.Remove(part)">✕</button>
                        </div>
                    }
                    <div class="split-footer">
                        <button type="button" class="link small" @onclick="AddPart">+ Ajouter une part</button>
                        @if (Remaining != 0)
                        {
                            <span class="negative small">Reste à répartir : @Remaining.ToString("C")</span>
                            <button type="button" class="link small" @onclick="FillRemaining">Mettre le reste sur la dernière part</button>
                        }
                        else
                        {
                            <span class="positive small">Total réparti ✓</span>
                        }
                        <span class="spacer"></span>
                        <button type="button" class="link small" @onclick="CancelSplit">Annuler la ventilation</button>
                    </div>
                </div>
            }

            @if (error is not null) { <p class="negative">@error</p> }

            <label class="inline">
                <InputCheckbox @bind-Value="model.IsTransfer" />
                Transfert (relevé de carte, virement vers un compte de crédit…) : sans catégorie, hors budget
            </label>

            <label>
                Notes
                <InputTextArea @bind-Value="model.Notes" rows="3" />
            </label>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a class="btn btn-ghost" href="depenses">Annuler</a>
                @if (!IsNew)
                {
                    <span class="spacer"></span>
                    <DeleteButton OnConfirm="Delete" />
                }
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery(Name = "compte")] public int? AccountQuery { get; set; }
    private bool IsNew => Id is null;
    private Expense? model;
    private List<BudgetCategory> categories = [];
    private List<Account> accounts = [];
    private List<string> payeeNames = [];
    private string payeeName = "";
    private string? payeeHint;
    private bool notFound;
    private string? error;

    // Ventilation en cours d'édition.
    private class Part
    {
        public int? CategoryId { get; set; }
        public decimal Amount { get; set; }
    }
    private List<Part> parts = [];
    private bool splitting;
    private decimal Remaining => model!.Amount - parts.Sum(p => p.Amount);

    private void StartSplit()
    {
        splitting = true;
        parts =
        [
            new Part { CategoryId = model!.CategoryId, Amount = model.Amount },
            new Part(),
        ];
    }

    private void AddPart() => parts.Add(new Part { Amount = Math.Max(Remaining, 0) });

    private void FillRemaining()
    {
        if (parts.Count > 0) parts[^1].Amount += Remaining;
    }

    private void CancelSplit()
    {
        splitting = false;
        model!.CategoryId = parts.FirstOrDefault()?.CategoryId;
        parts = [];
    }

    protected override async Task OnParametersSetAsync()
    {
        categories = await Budget.GetCategoriesAsync();
        accounts = await Accounts.GetAllAsync();
        payeeNames = await Payees.GetNamesAsync();
        model = IsNew
            ? new Expense { AccountId = accounts.Any(a => a.Id == AccountQuery) ? AccountQuery!.Value : Account.MainAccountId }
            : await Expenses.GetAsync(Id!.Value);
        notFound = model is null;
        payeeName = model?.Payee?.Name ?? "";
        parts = model?.Splits.Select(x => new Part { CategoryId = x.CategoryId, Amount = x.Amount }).ToList() ?? [];
        splitting = parts.Count > 0;
    }

    private async Task Save()
    {
        error = null;
        model!.Splits = splitting && !model.IsIncome && !model.IsTransfer
            ? parts.Select(p => new ExpenseSplit { CategoryId = p.CategoryId, Amount = p.Amount }).ToList()
            : [];
        try
        {
            await Expenses.SaveAsync(model, payeeName);
            Nav.NavigateTo("depenses");
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
    }

    /// <summary>Bénéficiaire connu avec une catégorie par défaut : on la propose si la dépense n'en a pas.</summary>
    private async Task OnPayeeChanged(ChangeEventArgs e)
    {
        payeeName = e.Value as string ?? "";
        payeeHint = null;
        var payee = await Payees.FindByNameAsync(payeeName);
        if (payee is null || model!.CategoryId is not null || model.IsTransfer) return;
        if (payee.DefaultIsTransfer)
        {
            model.IsTransfer = true;
            payeeHint = "Transfert par défaut pour ce bénéficiaire.";
        }
        else if (payee.DefaultCategoryId is { } cat)
        {
            model.CategoryId = cat;
            payeeHint = "Catégorie par défaut du bénéficiaire appliquée.";
        }
    }

    private async Task Delete()
    {
        await Expenses.DeleteAsync(Id!.Value);
        Nav.NavigateTo("depenses");
    }
}
