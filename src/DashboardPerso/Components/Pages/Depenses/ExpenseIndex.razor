@page "/depenses"
@inject ExpenseService Expenses
@inject BudgetService Budget
@inject AccountService Accounts
@inject OperationListState State
@implements IDisposable

<PageTitle>Opérations · Dashboard perso</PageTitle>

<header class="page-header">
    <h1>Opérations</h1>
    <div class="actions">
        <div class="segmented">
            <button class="@(yearView ? "" : "active")" @onclick="() => SetView(false)">Mois</button>
            <button class="@(yearView ? "active" : "")" @onclick="() => SetView(true)">Année</button>
        </div>
        @if (yearView)
        {
            <div class="month-selector">
                <button type="button" class="btn btn-ghost" @onclick="() => ChangeYear(-1)" title="Année précédente">‹</button>
                <span class="month-label">@month.Year</span>
                <button type="button" class="btn btn-ghost" @onclick="() => ChangeYear(1)" title="Année suivante">›</button>
            </div>
        }
        else
        {
            <MonthSelector Value="month" ValueChanged="OnMonthChanged" />
        }
        <a class="btn btn-ghost" href="depenses/import">Importer un relevé</a>
        <a class="btn btn-primary" href="@(accountFilter is { } acc ? $"depenses/nouvelle?compte={acc}" : "depenses/nouvelle")">+ Nouvelle opération</a>
    </div>
</header>

@if (items is null)
{
    <p class="muted">Chargement…</p>
}
else
{
    @* Une vue par provenance : tout, le compte, chaque carte. *@
    @if (accounts.Count > 1)
    {
        <div class="segmented source-tabs">
            <button class="@(accountFilter is null ? "active" : "")" @onclick="() => SetAccount(null)">Tout</button>
            @foreach (var a in accounts)
            {
                <button class="@(accountFilter == a.Id ? "active" : "")" @onclick="() => SetAccount(a.Id)">@a.Label</button>
            }
        </div>
    }

    <div class="toolbar">
        <div class="actions">
            <label class="inline">
                Catégorie
                <select @bind="categoryFilter">
                    <option value="">Toutes</option>
                    <option value="-1">Sans catégorie</option>
                    <CategoryOptions Categories="categories" />
                </select>
            </label>
            <label class="inline"><input type="checkbox" @bind="showTransfers" /> Transferts</label>
            <label class="inline"><input type="checkbox" @bind="showIncome" /> Recettes</label>
        </div>
        <span class="muted">
            @{ var spent = Filtered.Where(e => !e.IsTransfer && !e.IsIncome); }
            @spent.Count() dépense(s) · total <strong>@CategoryAmount(spent).ToString("C")</strong>
            @if (showIncome && Filtered.Any(e => e.IsIncome && !e.IsTransfer))
            {
                <span> · recettes <span class="positive">@CategoryAmount(Filtered.Where(e => e.IsIncome && !e.IsTransfer)).ToString("C")</span></span>
            }
            @if (showTransfers && Filtered.Any(e => e.IsTransfer))
            {
                <span> · transferts @Filtered.Where(e => e.IsTransfer).Sum(e => e.Amount).ToString("C")</span>
            }
        </span>
    </div>

    @* Liste en mémoire : remplaçable par <TelerikGrid Data="@items"> sans toucher au service. *@
    <div class="card table-card">
        <QuickGrid Items="Filtered" Pagination="pagination" Class="table">
            <PropertyColumn Title="Date" Property="e => e.Date" Format="dd/MM/yyyy" Sortable="true" IsDefaultSortColumn="true" InitialSortDirection="SortDirection.Descending" />
            <TemplateColumn Title="Libellé" SortBy="byLabel">
                <a href="depenses/@context.Id" class="@(context.IsTransfer ? "muted" : "")">@context.Label</a>
                <div class="muted small">
                    @if (context.Payee is not null) { <span>@context.Payee.Name</span> }
                    @if (accountFilter is null && context.AccountId != Account.MainAccountId)
                    {
                        <span>@(context.Payee is null ? "" : " · ")@context.Account?.Label</span>
                    }
                </div>
            </TemplateColumn>
            <TemplateColumn Title="Catégorie" SortBy="byCategory">
                @if (context.IsTransfer)
                {
                    <span class="badge transfer" title="Hors budget">Transfert</span>
                }
                else if (context.IsIncome && context.CategoryId is null && !context.IsSplit)
                {
                    <span class="badge income" title="Recette sans catégorie">Recette</span>
                }
                else if (context.IsSplit)
                {
                    <span class="badge split" title="@string.Join(" + ", context.Splits.Select(x => $"{x.Category?.Name ?? "Sans catégorie"} {x.Amount:C}"))">Ventilée · @context.Splits.Count catégories</span>
                }
                else
                {
                    <CategoryBadge Category="context.Category" ShowEmpty="true" />
                }
            </TemplateColumn>
            <TemplateColumn Title="Montant" SortBy="byAmount" Align="Align.End">
                @if (context.IsIncome)
                {
                    <span class="@(context.IsTransfer ? "muted" : "positive")">+@context.Amount.ToString("C")</span>
                }
                else
                {
                    <span class="@(context.IsTransfer ? "muted" : "")">@context.Amount.ToString("C")</span>
                }
            </TemplateColumn>
        </QuickGrid>
    </div>
    <Pager State="pagination" />
}

@code {
    private List<Expense>? items;
    [SupplyParameterFromQuery(Name = "vue")] public string? ViewQuery { get; set; }
    [SupplyParameterFromQuery(Name = "compte")] public int? AccountQuery { get; set; }
    private List<BudgetCategory> categories = [];
    private List<Account> accounts = [];

    // L'état de la liste est conservé (OperationListState) pour la retrouver telle quelle au retour d'une fiche.
    private DateOnly month { get => State.Month; set => State.Month = value; }
    /// <summary>Vue « Année » : toutes les opérations de l'année du mois sélectionné.</summary>
    private bool yearView { get => State.YearView; set => State.YearView = value; }
    private string categoryFilter { get => State.CategoryFilter; set => State.CategoryFilter = value; }
    private int? accountFilter { get => State.AccountId; set => State.AccountId = value; }
    private bool showTransfers { get => State.ShowTransfers; set => State.ShowTransfers = value; }
    private bool showIncome { get => State.ShowIncome; set => State.ShowIncome = value; }
    private readonly PaginationState pagination = new() { ItemsPerPage = 20 };

    private readonly GridSort<Expense> byLabel = GridSort<Expense>.ByAscending(e => e.Label);
    private readonly GridSort<Expense> byAmount = GridSort<Expense>.ByAscending(e => e.Amount);
    private readonly GridSort<Expense> byCategory = GridSort<Expense>.ByAscending(
        e => e.IsTransfer ? "~transfert" : e.Category == null ? "" : e.Category.FullName);

    private IQueryable<Expense> Filtered
    {
        get
        {
            IEnumerable<Expense> q = items!;
            if (accountFilter is { } a) q = q.Where(e => e.AccountId == a);
            if (!showTransfers) q = q.Where(e => !e.IsTransfer);
            if (!showIncome) q = q.Where(e => !e.IsIncome);
            q = categoryFilter switch
            {
                "" => q,
                "-1" => q.Where(e => e.CategoryId == null && !e.IsTransfer && !e.IsSplit),
                // Une catégorie principale inclut ses sous-catégories ; une dépense ventilée y figure si une part y est.
                var id => q.Where(e => InCategory(e.Category, int.Parse(id)) || e.Splits.Any(x => InCategory(x.Category, int.Parse(id)))),
            };
            return q.AsQueryable();
        }
    }

    private static bool InCategory(BudgetCategory? c, int id) => c is not null && (c.Id == id || c.ParentId == id);

    /// <summary>Total des dépenses ; avec un filtre de catégorie, seules les parts concernées des dépenses ventilées comptent.</summary>
    private decimal CategoryAmount(IEnumerable<Expense> expenses)
    {
        if (!int.TryParse(categoryFilter, out var id) || id < 0) return expenses.Sum(e => e.Amount);
        return expenses.Sum(e => e.IsSplit ? e.Splits.Where(x => InCategory(x.Category, id)).Sum(x => x.Amount) : e.Amount);
    }

    protected override async Task OnInitializedAsync()
    {
        categories = await Budget.GetCategoriesAsync();
        accounts = await Accounts.GetAllAsync();
        if (AccountQuery is not null) accountFilter = accounts.Any(a => a.Id == AccountQuery) ? AccountQuery : null;
        else if (accountFilter is { } acc && accounts.All(a => a.Id != acc)) accountFilter = null;
        if (ViewQuery is not null) yearView = ViewQuery == "annee";
        await Load();
        await pagination.SetCurrentPageIndexAsync(State.PageIndex);
    }

    public void Dispose() => State.PageIndex = pagination.CurrentPageIndex;

    private async Task SetAccount(int? id)
    {
        accountFilter = id;
        await pagination.SetCurrentPageIndexAsync(0);
    }

    private async Task OnMonthChanged(DateOnly value)
    {
        month = value;
        await Load();
        await pagination.SetCurrentPageIndexAsync(0);
    }

    private async Task SetView(bool year)
    {
        if (yearView == year) return;
        yearView = year;
        await Reload();
    }

    private async Task ChangeYear(int delta)
    {
        month = month.AddYears(delta);
        await Reload();
    }

    private async Task Reload()
    {
        await Load();
        await pagination.SetCurrentPageIndexAsync(0);
    }

    private async Task Load()
    {
        pagination.ItemsPerPage = yearView ? 50 : 20;
        items = yearView
            ? await Expenses.GetByYearAsync(month.Year)
            : await Expenses.GetByMonthAsync(month.Year, month.Month);
    }
}
