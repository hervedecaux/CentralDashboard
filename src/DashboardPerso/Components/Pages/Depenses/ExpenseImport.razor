@page "/depenses/import"
@inject ImportService Import
@inject BudgetService Budget
@inject CategoryRuleService Rules
@inject AccountService Accounts

<PageTitle>Importer un relevé · Dashboard perso</PageTitle>

<header class="page-header">
    <h1>Importer un relevé bancaire</h1>
    <div class="actions">
        <a class="btn btn-ghost" href="depenses/regles">Règles de catégorie</a>
        <a class="btn btn-ghost" href="depenses">Retour aux dépenses</a>
    </div>
</header>

@if (result is not null)
{
    <div class="card notice success">
        <strong>@result opération(s) importée(s).</strong>
        <a href="depenses">Voir les dépenses</a> · <button class="link" @onclick="Reset">Importer un autre fichier</button>
    </div>
}
else if (rows is null)
{
    <div class="card form-card">
        <p>
            Sélectionnez le fichier CSV « Liste des opérations » téléchargé depuis votre espace Crédit Agricole.
            Rien n'est enregistré avant votre validation : vous verrez d'abord un aperçu.
        </p>
        <label>
            Fichier CSV
            <InputFile OnChange="OnFileSelected" accept=".csv,text/csv" />
        </label>
        @if (loading) { <p class="muted">Lecture du fichier…</p> }
        @if (error is not null) { <p class="negative">@error</p> }
        <p class="muted small">
            Les débits deviennent des dépenses, les crédits des recettes (hors budget, utiles au solde). Une opération déjà importée est reconnue
            et ignorée : vous pouvez réimporter un fichier qui chevauche le précédent sans créer de doublon.
        </p>
    </div>
}
else
{
    <section class="cards">
        <div class="card stat"><span class="stat-label">Fichier</span><span>@fileName</span><span class="muted">@rows.Count opérations, du @rows.Min(r => r.Operation.Date).ToString("dd/MM/yyyy") au @rows.Max(r => r.Operation.Date).ToString("dd/MM/yyyy")</span></div>
        <div class="card stat">
            <span class="stat-label">Nouvelles opérations</span>
            <span class="stat-value">@Count(ImportStatus.New)</span>
            @foreach (var g in rows.Where(r => r.Status == ImportStatus.New).GroupBy(r => r.Operation.Source))
            {
                <span class="muted small">@SourceLabel(g.Key) : @g.Count()</span>
            }
        </div>
        <div class="card stat"><span class="stat-label">Ignorées</span><span>@Count(ImportStatus.AlreadyImported) déjà importée(s)</span><span>@Count(ImportStatus.PossibleDuplicate) doublon(s) possible(s)</span>@if (bankBalance is not null) {<span class="muted small">Solde banque au @bankBalanceDate?.ToString("dd/MM/yyyy") : @bankBalance?.ToString("C")</span>}</div>
    </section>

    @if (ruleDraft is not null)
    {
        <div class="card rule-draft">
            <strong>Nouvelle règle</strong>
            <span class="muted">Les libellés contenant</span>
            <input @bind="ruleDraft.Pattern" @bind:event="oninput" />
            <span class="muted">vont dans</span>
            <select @bind="ruleDraft.Target">
                <option value="">Choisir…</option>
                <option value="@TransferValue">Transfert (sans catégorie, hors budget)</option>
                <CategoryOptions Categories="categories" Kind="ruleDraft.Kind" />
            </select>
            <button class="btn btn-primary" disabled="@(ruleDraft.Target == "" || string.IsNullOrWhiteSpace(ruleDraft.Pattern))" @onclick="SaveRule">Créer et appliquer</button>
            <button class="btn btn-ghost" @onclick="() => ruleDraft = null">Annuler</button>
        </div>
    }

    @if (sources.Count > 1)
    {
        <div class="segmented source-tabs">
            <button class="@(sourceFilter == "" ? "active" : "")" @onclick='() => sourceFilter = ""'>Tout</button>
            @foreach (var s in sources)
            {
                <button class="@(sourceFilter == s ? "active" : "")" @onclick="() => sourceFilter = s">@SourceLabel(s)</button>
            }
        </div>
    }

    <div class="toolbar">
        <label class="inline"><input type="checkbox" @bind="showIgnored" /> Afficher les lignes ignorées</label>
        <span class="muted">
            @Selected.Count() sélectionnée(s) · dépenses <strong>@Selected.Where(r => !r.IsTransfer && !r.IsIncome).Sum(r => r.Operation.Amount).ToString("C")</strong>
            @if (Selected.Any(r => r.IsIncome && !r.IsTransfer)) { <span> · recettes <span class="positive">@Selected.Where(r => r.IsIncome && !r.IsTransfer).Sum(r => r.Operation.Amount).ToString("C")</span></span> }
            @if (Selected.Any(r => r.IsTransfer)) { <span> · transferts @Selected.Where(r => r.IsTransfer).Sum(r => r.Operation.Amount).ToString("C")</span> }
        </span>
    </div>

    <div class="card table-card">
        <table class="table import-table">
            <thead>
                <tr>
                    <th class="col-check"></th>
                    <th>Date</th>
                    <th>Libellé</th>
                    <th class="col-justify-end">Montant</th>
                    <th>Catégorie</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Visible)
                {
                    <tr class="@(row.Include ? "" : "excluded")">
                        <td>
                            <input type="checkbox" @bind="row.Include" disabled="@(row.Status is ImportStatus.AlreadyImported)" />
                        </td>
                        <td>@row.Operation.Date.ToString("dd/MM")</td>
                        <td>
                            <input class="label-input" @bind="row.Label" title="@row.Operation.RawLabel" />
                            <div class="muted small">
                                @row.Operation.Type
                                @if (!row.Operation.IsCardStatementTotal) { <span> · @row.Payee</span> }
                                @if (sourceFilter == "" && row.Operation.IsCardOperation) { <span class="badge">@SourceLabel(row.Operation.Source)</span> }
                                @if (row.Operation.IsCardStatementTotal) { <span class="badge transfer" title="Total des paiements par carte, importés en détail depuis la section carte">Relevé carte</span> }
                                @if (row.IsIncome) { <span class="badge income">Recette</span> }
                                @switch (row.Status)
                                {
                                    case ImportStatus.AlreadyImported: <span class="badge">Déjà importée</span>; break;
                                    case ImportStatus.PossibleDuplicate: <span class="badge warn" title="Une dépense saisie à la main a la même date et le même montant">Doublon possible</span>; break;
                                }
                            </div>
                        </td>
                        <td class="col-justify-end amount">
                            @if (row.Operation.IsDebit) { @row.Operation.Debit!.Value.ToString("C") }
                            else { <span class="positive">+@(row.Operation.Credit?.ToString("C"))</span> }
                        </td>
                        <td>
                            <select value="@(row.IsTransfer ? TransferValue : row.CategoryId?.ToString() ?? "")" @onchange="e => SetCategory(row, e.Value as string)">
                                <option value="">@(row.IsIncome ? "Recette sans catégorie" : "Sans catégorie")</option>
                                <option value="@TransferValue">@(row.IsIncome ? "Transfert (ex. depuis l'épargne)" : "Transfert (hors budget)")</option>
                                <CategoryOptions Categories="categories" Kind="KindOf(row)" />
                            </select>
                            @if (row.FromPayeeDefault)
                            {
                                <div class="muted small">défaut du bénéficiaire</div>
                            }
                            else if (row.MatchedRule is not null)
                            {
                                <div class="muted small">règle « @row.MatchedRule »</div>
                            }
                        </td>
                        <td>
                            @if (!row.Operation.IsCardStatementTotal)
                            {
                                <button class="link small" @onclick="() => StartRule(row)" title="Catégoriser automatiquement les opérations similaires">+ règle</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="form-actions">
        <button class="btn btn-primary" disabled="@(!Selected.Any() || saving)" @onclick="Save">
            Importer @Selected.Count() opération(s)
        </button>
        <button class="btn btn-ghost" @onclick="Reset">Annuler</button>
    </div>
}

@code {
    private List<ImportRow>? rows;
    private List<BudgetCategory> categories = [];
    private string? fileName, error;
    private bool loading, saving, showIgnored;
    private int? result;
    private RuleDraft? ruleDraft;

    private class RuleDraft
    {
        public string Pattern { get; set; } = "";
        /// <summary>Id de catégorie, ou <see cref="TransferValue"/>.</summary>
        public string Target { get; set; } = "";
        /// <summary>Recette ou dépense, d'après l'opération qui a servi de modèle.</summary>
        public CategoryKind Kind { get; init; }
    }

    private static CategoryKind KindOf(ImportRow row) => row.IsIncome ? CategoryKind.Income : CategoryKind.Expense;

    private const string TransferValue = "transfert";
    private string sourceFilter = "";
    private List<string> sources = [];
    private Dictionary<string, string> accountLabels = [];

    /// <summary>Libellé configuré du compte ou de la carte, sinon celui proposé par le relevé.</summary>
    private string SourceLabel(string source) => accountLabels.TryGetValue(source, out var label) ? label
        : rows?.FirstOrDefault(r => r.Operation.Source == source)?.Operation.DefaultSourceLabel ?? source;

    private IEnumerable<ImportRow> Visible => rows!
        .Where(r => showIgnored || r.Status is ImportStatus.New or ImportStatus.PossibleDuplicate)
        .Where(r => sourceFilter == "" || r.Operation.Source == sourceFilter);

    private IEnumerable<ImportRow> Selected => rows?.Where(r => r.Include) ?? [];
    private decimal? bankBalance;
    private DateOnly? bankBalanceDate;

    private int Count(ImportStatus s) => rows!.Count(r => r.Status == s);

    protected override async Task OnInitializedAsync() => categories = await Budget.GetCategoriesAsync();

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        error = null;
        loading = true;
        try
        {
            var file = e.File;
            if (file.Size > ImportService.MaxFileSize)
                throw new InvalidOperationException("Fichier trop volumineux (5 Mo maximum).");
            await using var stream = file.OpenReadStream(ImportService.MaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            fileName = file.Name;
            var preview = await Import.PreviewStatementAsync(ms.ToArray());
            rows = preview.Rows;
            (bankBalance, bankBalanceDate) = (preview.BankBalance, preview.BankBalanceDate);
            sources = rows.Select(r => r.Operation.Source).Distinct()
                .OrderBy(s => s != BankOperation.AccountSource).ThenBy(s => s).ToList();
            sourceFilter = "";
            accountLabels = await Accounts.GetLabelsByImportIdAsync();
            if (rows.Count == 0)
            {
                rows = null;
                error = "Aucune opération trouvée dans ce fichier.";
            }
        }
        catch (Exception ex) when (ex is FormatException or InvalidOperationException or IOException)
        {
            rows = null;
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void SetCategory(ImportRow row, string? value)
    {
        row.IsTransfer = value == TransferValue;
        row.CategoryId = int.TryParse(value, out var id) ? id : null;
        row.CategoryChosenByUser = true;
        row.MatchedRule = null;
    }

    private void StartRule(ImportRow row) => ruleDraft = new RuleDraft
    {
        // Proposition : début du bénéficiaire, à raccourcir au besoin (ex. « ORANGE SA »).
        Pattern = SuggestPattern(row.Operation.Description),
        Target = row.IsTransfer ? TransferValue : row.CategoryId?.ToString() ?? "",
        Kind = KindOf(row),
    };

    /// <summary>« ORANGE SA-ORANGE - Orange - Votre abonnement… » → « ORANGE SA-ORANGE ».</summary>
    private static string SuggestPattern(string description)
    {
        var head = description.Split(" - ", 2)[0];
        return string.Join(' ', head.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(3));
    }

    private async Task SaveRule()
    {
        var transfer = ruleDraft!.Target == TransferValue;
        await Rules.AddAsync(ruleDraft.Pattern, transfer ? null : int.Parse(ruleDraft.Target), transfer);
        ruleDraft = null;
        await Import.ApplyRulesAsync(rows!);
    }

    private async Task Save()
    {
        saving = true;
        result = await Import.ImportAsync(rows!, bankBalance, bankBalanceDate);
        saving = false;
        rows = null;
    }

    private void Reset()
    {
        rows = null;
        result = null;
        error = null;
        ruleDraft = null;
    }
}
