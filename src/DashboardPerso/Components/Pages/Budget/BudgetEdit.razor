@page "/budget/nouveau"
@page "/budget/{Id:int}"
@inject BudgetService Budget
@inject NavigationManager Nav
@inject ILogger<BudgetEdit> Logger

<PageTitle>@Title · Dashboard perso</PageTitle>

<header class="page-header">
    <h1>@Title</h1>
</header>

@if (model is null)
{
    <p class="muted">@(notFound ? "Catégorie introuvable." : "Chargement…")</p>
}
else
{
    <div class="card form-card">
        <EditForm Model="model" OnValidSubmit="Save" FormName="budget-edit">
            <DataAnnotationsValidator />
            <ValidationSummary class="negative" />

            <label>
                Nom
                <InputText @bind-Value="model.Name" autofocus />
                <ValidationMessage For="() => model.Name" />
            </label>

            <div class="field">
                <span>Type</span>
                <div class="segmented">
                    <button type="button" class="@(model.IsIncome ? "" : "active")" disabled="@KindLocked" @onclick="() => SetKind(CategoryKind.Expense)">Dépenses</button>
                    <button type="button" class="@(model.IsIncome ? "active" : "")" disabled="@KindLocked" @onclick="() => SetKind(CategoryKind.Income)">Recettes</button>
                </div>
                @if (model.ParentId is not null)
                {
                    <span class="muted small">Une sous-catégorie a le type de sa catégorie principale.</span>
                }
            </div>

            <label>
                Catégorie parente
                @if (childCount > 0)
                {
                    <select disabled><option>Aucune (catégorie principale)</option></select>
                    <span class="muted small">Elle a @childCount sous-catégorie(s) : elle reste une catégorie principale.</span>
                }
                else
                {
                    <InputSelect @bind-Value="model.ParentId" @bind-Value:after="OnParentChanged">
                        <option value="">Aucune (catégorie principale)</option>
                        @foreach (var p in parents.Where(p => p.Kind == model.Kind))
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </InputSelect>
                }
            </label>

            <div class="form-row">
                <label>
                    @(model.IsIncome
                        ? (childCount > 0 ? "Recettes prévues par an, non réparties (€)" : "Recettes prévues par an (€)")
                        : (childCount > 0 ? "Budget annuel non réparti (€)" : "Budget annuel (€)"))
                    <InputNumber @bind-Value="model.AnnualBudget" step="0.01" />
                    <ValidationMessage For="() => model.AnnualBudget" />
                    <span class="muted small">
                        @if (childCount > 0)
                        {
                            @($"S'ajoute aux montants des sous-catégories ({childrenBudget.ToString("C")}). Total : {(childrenBudget + model.AnnualBudget).ToString("C")}.")
                        }
                        else
                        {
                            @($"Soit {(model.AnnualBudget / 12).ToString("C")} par mois.")
                        }
                    </span>
                </label>
                <label>
                    Couleur
                    <InputText type="color" @bind-Value="model.Color" />
                </label>
            </div>

            @if (error is not null) { <p class="negative">@error</p> }

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a class="btn btn-ghost" href="budget">Annuler</a>
            </div>
        </EditForm>
    </div>

    @if (!IsNew)
    {
        <div class="card form-card danger-zone">
            <h2>Supprimer la catégorie</h2>
            @if (childCount > 0)
            {
                <p class="muted">Cette catégorie a des sous-catégories. Supprimez-les ou rattachez-les à une autre catégorie avant de la supprimer.</p>
            }
            else
            {
                @if (usage.Expenses + usage.Rules > 0)
                {
                    <label>
                        @($"Que faire de ses {usage.Expenses} opération(s) et {usage.Rules} règle(s) ?")
                        <select @bind="reassignTo">
                            <option value="">Opérations sans catégorie, règles supprimées</option>
                            @foreach (var c in others.Where(c => c.Kind == model.Kind))
                            {
                                <option value="@c.Id">Les rattacher à @c.FullName</option>
                            }
                        </select>
                    </label>
                }
                else
                {
                    <p class="muted">Aucune opération ni règle n'utilise cette catégorie.</p>
                }
                @if (deleteError is not null) { <p class="negative">@deleteError</p> }
                <div class="form-actions">
                    <DeleteButton OnConfirm="Delete" />
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery(Name = "parent")] public int? ParentQuery { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? TypeQuery { get; set; }

    private bool IsNew => Id is null;
    private string Title => IsNew
        ? (model?.ParentId is not null ? "Nouvelle sous-catégorie" : model?.IsIncome == true ? "Nouvelle catégorie de recettes" : "Nouvelle catégorie")
        : "Modifier la catégorie";

    /// <summary>Le type d'une sous-catégorie suit celui de sa catégorie principale.</summary>
    private bool KindLocked => model?.ParentId is not null;

    private BudgetCategory? model;
    private List<BudgetCategory> parents = [];
    private List<BudgetCategory> others = [];
    private int childCount;
    private decimal childrenBudget;
    private (int Expenses, int Rules) usage;
    private string reassignTo = "";
    private bool notFound;
    private string? error;
    private string? deleteError;

    protected override async Task OnParametersSetAsync()
    {
        parents = await Budget.GetTopLevelAsync(exceptId: Id);
        if (IsNew)
        {
            var parent = parents.FirstOrDefault(p => p.Id == ParentQuery);
            var kind = parent?.Kind ?? (TypeQuery == "recette" ? CategoryKind.Income : CategoryKind.Expense);
            model = new BudgetCategory
            {
                ParentId = parent?.Id,
                Kind = kind,
                Color = parent?.Color ?? (kind == CategoryKind.Income ? "#2e9d5b" : "#4f6bed"),
            };
            return;
        }

        model = await Budget.GetAsync(Id!.Value);
        notFound = model is null;
        if (model is null) return;
        childCount = model.Children.Count;
        childrenBudget = model.Children.Sum(c => c.AnnualBudget);
        model.Children = [];   // évite de renvoyer le graphe à l'enregistrement
        model.Parent = null;
        usage = await Budget.GetUsageAsync(model.Id);
        others = (await Budget.GetCategoriesAsync()).Where(c => c.Id != model.Id).ToList();
    }

    private void SetKind(CategoryKind kind)
    {
        if (model is null || model.Kind == kind) return;
        model.Kind = kind;
        if (model.ParentId is { } p && parents.FirstOrDefault(x => x.Id == p)?.Kind != kind) model.ParentId = null;
    }

    private void OnParentChanged()
    {
        if (model?.ParentId is { } p && parents.FirstOrDefault(x => x.Id == p) is { } parent) model.Kind = parent.Kind;
    }

    private async Task Save()
    {
        error = null;
        try
        {
            await Budget.SaveAsync(model!);
            Nav.NavigateTo("budget");
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex)
        {
            // Erreur inattendue (base de données…) : on l'affiche au lieu de bloquer la page.
            Logger.LogError(ex, "Enregistrement de la catégorie {Id}", model?.Id);
            error = "L'enregistrement a échoué : " + (ex.InnerException?.Message ?? ex.Message);
        }
    }

    private async Task Delete()
    {
        deleteError = null;
        try
        {
            await Budget.DeleteAsync(Id!.Value, int.TryParse(reassignTo, out var target) ? target : null);
            Nav.NavigateTo("budget");
        }
        catch (Exception ex) when (ex is CategoryInUseException or InvalidOperationException)
        {
            deleteError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Suppression de la catégorie {Id}", Id);
            deleteError = "La suppression a échoué : " + (ex.InnerException?.Message ?? ex.Message);
        }
    }
}
