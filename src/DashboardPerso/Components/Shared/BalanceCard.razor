@* Solde théorique de chaque compte bancaire comparé au solde indiqué par la banque. *@
@inject AccountService Accounts

@if (shown.Count == 0)
{
    <div class="card stat">
        <span class="stat-label">Solde théorique</span>
        <span class="muted">Saisissez un solde initial dans <a href="comptes">Comptes et cartes</a>.</span>
    </div>
}
@foreach (var (account, balance) in shown)
{
    <div class="card stat" @key="account.Id">
        <span class="stat-label">@(shown.Count == 1 ? "Solde théorique" : $"Solde · {account.Label}")</span>
        <span class="stat-value @(balance!.Theoretical < 0 ? "negative" : "")">@balance.Theoretical.ToString("C")</span>
        @if (balance.Difference is { } diff)
        {
            <span class="@(diff == 0 ? "positive" : "negative") small">
                Banque au @balance.BankDate?.ToString("dd/MM") : @balance.BankBalance?.ToString("C")
                @(diff == 0 ? " ✓" : $" (écart {diff:+#,##0.00 €;-#,##0.00 €})")
            </span>
        }
        else
        {
            <span class="muted small">depuis @balance.InitialBalance.ToString("C") le @balance.InitialDate.ToString("dd/MM/yyyy")</span>
        }
    </div>
}

@code {
    private List<AccountBalanceSummary> shown = [];

    protected override async Task OnInitializedAsync() =>
        shown = (await Accounts.GetBankBalancesAsync()).Where(b => b.Balance is not null).ToList();
}
