<?xml version="1.0" encoding="utf-8"?>
<!--
  Sources NuGet du projet : uniquement nuget.org.
  <clear /> ignore les sources configurées globalement sur la machine (ex. le flux Telerik d'un autre
  projet, qui demande une authentification et ferait échouer la restauration ou la publication).
  Pour passer plus tard à Telerik UI for Blazor, ajoutez ici la source https://nuget.telerik.com/v3/index.json
  (identifiants à stocker hors du dépôt).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
